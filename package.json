{
  "name": "biliban",
  "type": "module",
  "version": "6.9.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "description": "哔哩哔哩 - 屏蔽指定内容（浏览器扩展）",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run lint && bun run test",
    "package": "bun run check && node scripts/package.mjs",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "simple-git-hooks": "^2.14.0",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check"
  }
}
