{
  "manifest_version": 3,
  "name": "哔哩哔哩 - 屏蔽指定内容",
  "version": "4.8.0",
  "description": "按用户名、关键字或正则表达式屏蔽 bilibili 的视频(直播间/相薄)与评论(回复)；支持粉丝勋章屏蔽、消息中心自动删除、多标签页同步。",
  "permissions": ["storage"],
  "host_permissions": ["*://*.bilibili.com/*", "https://api.bilibili.com/*"],
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/*",
        "*://search.bilibili.com/*",
        "*://live.bilibili.com/*",
        "*://space.bilibili.com/*",
        "*://t.bilibili.com/*",
        "*://h.bilibili.com/*",
        "*://manga.bilibili.com/*",
        "*://message.bilibili.com/*"
      ],
      "js": ["src/content/entry.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/main.js",
        "src/content/constants.js",
        "src/content/config/defaults.js",
        "src/content/config/serialize.js",
        "src/content/config/migrate.js",
        "src/content/config/store.js",
        "src/content/matcher/decide-text.js",
        "src/content/matcher/decide-username.js",
        "src/content/matcher/whitelist.js",
        "src/content/matcher/convert-text.js",
        "src/content/util/string-to-array.js",
        "src/content/util/segments.js",
        "src/content/util/list-order.js",
        "src/content/util/date.js",
        "src/content/dom/hide-operation.js",
        "src/content/dom/extract-ele.js",
        "src/content/dom/bv.js",
        "src/content/dom/arrive.js",
        "src/content/rules/handler-table.js",
        "src/content/engine/url-gate.js",
        "src/content/engine/hide-handler.js",
        "src/content/engine/hide-event.js",
        "src/content/engine/scheduler.js",
        "src/content/resolver/username-resolver.js",
        "src/content/panel/styles.js",
        "src/content/panel/field-descriptors.js",
        "src/content/panel/panel-text.js",
        "src/content/panel/panel.js",
        "src/content/panel/fields.js",
        "src/content/panel/chips.js",
        "src/content/panel/input-row.js",
        "src/content/panel/trigger.js",
        "src/content/panel/big-bang.js",
        "src/content/buttons/button-factory.js",
        "src/content/pages/www.js",
        "src/content/pages/dynamics.js",
        "src/content/pages/message-reply.js",
        "src/content/pages/live-chat.js",
        "src/content/pages/hide-comment.js",
        "src/content/pages/triggers.js"
      ],
      "matches": ["*://*.bilibili.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
