{
  "manifest_version": 3,
  "name": "哔哩哔哩 - 屏蔽指定内容",
  "version": "6.4.0",
  "description": "按屏蔽词（关键字/正则，纯文字匹配）屏蔽 bilibili 视频卡片，支持页面作用域（搜索/空间/播放/收藏）、过期式临时屏蔽、时长按蔽与可编辑的选择器规则；多标签页同步。",
  "permissions": ["storage"],
  "host_permissions": ["*://*.bilibili.com/*", "https://api.bilibili.com/*"],
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/*",
        "*://search.bilibili.com/*",
        "*://space.bilibili.com/*",
        "*://t.bilibili.com/*"
      ],
      "js": ["src/content/entry.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/main.js",
        "src/content/constants.js",
        "src/content/config/defaults.js",
        "src/content/config/migrate.js",
        "src/content/config/scopes.js",
        "src/content/config/serialize.js",
        "src/content/config/store.js",
        "src/content/config/temp-store.js",
        "src/content/dom/arrive.js",
        "src/content/dom/extract-ele.js",
        "src/content/dom/hide-operation.js",
        "src/content/engine/category.js",
        "src/content/engine/decide.js",
        "src/content/engine/duration.js",
        "src/content/engine/hide-event.js",
        "src/content/engine/hide-handler.js",
        "src/content/engine/rule-stats.js",
        "src/content/engine/scheduler.js",
        "src/content/panel/chips.js",
        "src/content/panel/input-row.js",
        "src/content/panel/panel-text.js",
        "src/content/panel/panel.js",
        "src/content/panel/styles.js",
        "src/content/panel/trigger.js",
        "src/content/panel/sections/general.js",
        "src/content/panel/sections/durations.js",
        "src/content/panel/sections/entries.js",
        "src/content/panel/sections/rules.js",
        "src/content/panel/sections/scope-pane.js",
        "src/content/rules/builtin-rules.js",
        "src/content/util/list-order.js",
        "src/content/util/string-to-array.js"
      ],
      "matches": ["*://*.bilibili.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
